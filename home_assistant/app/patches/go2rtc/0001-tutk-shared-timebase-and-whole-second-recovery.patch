diff --git a/pkg/tutk/frame_ts_sim_test.go b/pkg/tutk/frame_ts_sim_test.go
new file mode 100644
index 0000000..9e2db18
--- /dev/null
+++ b/pkg/tutk/frame_ts_sim_test.go
@@ -0,0 +1,281 @@
+package tutk
+
+import (
+	"testing"
+	"time"
+)
+
+// Frame spacings measured off a real HL_CAM4 (go2rtc verbose output,
+// 2026-09-23).  Video is metronomic; audio alternates 40ms and 80ms and
+// averages the 64ms of one 1024-sample AAC frame at 16kHz.
+// One stall roughly every 48s of audio, which reproduces the ~1.25s/min the
+// per-frame correction was measured running away at on the real camera.
+const audioBurstEvery = 750
+
+var (
+	realVideoDeltas = []uint32{49972, 49971, 49971, 49974, 49965, 49975, 49967, 49971, 49979, 49971, 49968, 49971}
+	realAudioDeltas = []uint32{
+		80006, 80016, 40012, 80010, 40005, 80018, 80012, 80022, 40005, 80022, 80020, 40029,
+		80010, 40012, 80029, 80008, 40007, 80024, 40007, 80016, 80029, 40006, 80017, 40007,
+		80027, 80014, 40007, 80023, 40006, 80017, 80020, 40011, 80019, 40008, 80014, 80030,
+	}
+)
+
+// openLoopTracker is the first attempt at this fix: it measured the gap
+// against the previous frame instead of a fixed origin.  Kept so the
+// simulation below can show why that does not hold up.
+type openLoopTracker struct {
+	lastRawTS uint32
+	lastWall  time.Time
+	accumUS   uint64
+	firstTS   bool
+	startUS   uint64
+}
+
+func (t *openLoopTracker) update(rawTS uint32, now time.Time) uint64 {
+	if !t.firstTS {
+		t.firstTS = true
+		t.lastRawTS = rawTS
+		t.lastWall = now
+		t.accumUS = t.startUS
+		return t.accumUS
+	}
+	var delta uint32
+	if rawTS >= t.lastRawTS {
+		delta = rawTS - t.lastRawTS
+	} else {
+		delta = (tsWrapPeriod - t.lastRawTS) + rawTS
+	}
+	advance := uint64(delta)
+	if wall := now.Sub(t.lastWall); wall > 0 {
+		missing := (wall - time.Duration(delta)*time.Microsecond + time.Second/2) / time.Second
+		if missing > 0 {
+			advance += uint64(missing) * uint64(tsWrapPeriod)
+		}
+	}
+	t.accumUS += advance
+	t.lastRawTS = rawTS
+	t.lastWall = now
+	return t.accumUS
+}
+
+// deterministic jitter, so a failure is always reproducible
+type rng struct{ s uint64 }
+
+func (r *rng) next(n uint64) uint64 {
+	r.s = r.s*6364136223846793005 + 1442695040888963407
+	return (r.s >> 33) % n
+}
+
+type arrival struct {
+	raw   uint32
+	when  time.Duration // since the shared origin
+	audio bool
+}
+
+// buildStream produces one camera's worth of frames, with delivery that is
+// late and bursty the way the real audio track is: the camera keeps perfect
+// time, but frames reach us in clumps after sub-second stalls.
+// Both tracks must be generated over the same span of camera time, not the
+// same number of frames: audio frames are 64ms and video frames 50ms, so
+// equal counts would end tens of seconds apart and look exactly like drift.
+func buildStream(deltas []uint32, startRaw uint32, span time.Duration, audio bool, r *rng, burstEvery int) []arrival {
+	out := []arrival{}
+	var cameraUS uint64
+	raw := startRaw
+	var held time.Duration
+	limit := uint64(span / time.Microsecond)
+
+	for i := 0; cameraUS <= limit; i++ {
+		d := deltas[i%len(deltas)]
+		if i > 0 {
+			cameraUS += uint64(d)
+			raw = uint32((uint64(raw) + uint64(d)) % uint64(tsWrapPeriod))
+			if cameraUS > limit {
+				break
+			}
+		}
+		when := time.Duration(cameraUS) * time.Microsecond
+
+		// A stall holds one frame back by 600-900ms — under the one-second
+		// mark, so no second was really lost — and the frames behind it then
+		// arrive bunched up as delivery catches back up.  That leading gap is
+		// what a per-frame correction mistakes for a lost second.
+		if burstEvery > 0 && i > 0 && i%burstEvery == 0 {
+			held = time.Duration(600+r.next(300)) * time.Millisecond
+		}
+		when += held
+		if held > 0 {
+			if held > 200*time.Millisecond {
+				held -= 200 * time.Millisecond
+			} else {
+				held = 0
+			}
+		}
+		when += time.Duration(r.next(25)) * time.Millisecond // ordinary jitter
+
+		out = append(out, arrival{raw: raw, when: when, audio: audio})
+	}
+	return out
+}
+
+func merge(a, b []arrival) []arrival {
+	out := make([]arrival, 0, len(a)+len(b))
+	i, j := 0, 0
+	for i < len(a) || j < len(b) {
+		switch {
+		case j >= len(b) || (i < len(a) && a[i].when <= b[j].when):
+			out = append(out, a[i])
+			i++
+		default:
+			out = append(out, b[j])
+			j++
+		}
+	}
+	return out
+}
+
+// TestClosedLoopDoesNotDriftUnderBurstyDelivery is the regression this patch
+// exists for.  Ten minutes of measured frame spacing with audio delivered in
+// bursts: what must not happen is the two timelines *walking apart*, because
+// MediaMTX's fMP4 recorder discards audio that falls before the current
+// segment's start and the gap never closes on its own.
+//
+// Brief excursions during a stall are fine — they cost a frame or two.  A
+// steady divergence costs the whole audio track.
+func TestClosedLoopDoesNotDriftUnderBurstyDelivery(t *testing.T) {
+	const span = 10 * time.Minute
+
+	r := &rng{s: 42}
+	video := buildStream(realVideoDeltas, 694144, span, false, r, 0)
+	audio := buildStream(realAudioDeltas, 52613, span, true, r, audioBurstEvery)
+	stream := merge(video, audio)
+
+	epoch := time.Unix(1700000000, 0)
+	h := NewFrameHandler(false)
+
+	var lastVideo, lastAudio uint64
+	var worst int64
+	var splits []int64
+	for _, f := range stream {
+		now := epoch.Add(f.when)
+		if f.audio {
+			lastAudio = h.audioTS.update(f.raw, now)
+		} else {
+			lastVideo = h.videoTS.update(f.raw, now)
+		}
+		if lastVideo == 0 || lastAudio == 0 {
+			continue
+		}
+		gap := int64(lastVideo) - int64(lastAudio)
+		if gap < 0 {
+			gap = -gap
+		}
+		splits = append(splits, gap)
+		if gap > worst {
+			worst = gap
+		}
+	}
+
+	final := int64(lastVideo) - int64(lastAudio)
+	if final < 0 {
+		final = -final
+	}
+
+	// How often the split is small, rather than how bad one spike got.
+	var wide int
+	for _, g := range splits {
+		if g > int64(500*time.Millisecond/time.Microsecond) {
+			wide++
+		}
+	}
+	widePct := float64(wide) * 100 / float64(len(splits))
+
+	t.Logf("after %v: final split %.3fs, worst %.3fs, %.2f%% of samples over 0.5s",
+		span, float64(final)/1e6, float64(worst)/1e6, widePct)
+
+	// The actual bug: the tracks must not end up apart.
+	if final > int64(250*time.Millisecond/time.Microsecond) {
+		t.Fatalf("tracks ended %.3fs apart, want under 0.25s", float64(final)/1e6)
+	}
+	// And the split must be small almost all of the time, not just at the end.
+	if widePct > 1.0 {
+		t.Fatalf("split exceeded 0.5s in %.2f%% of samples, want under 1%%", widePct)
+	}
+	// Excursions during a stall are tolerable but must stay bounded.
+	if worst > int64(1500*time.Millisecond/time.Microsecond) {
+		t.Fatalf("worst excursion %.3fs, want under 1.5s", float64(worst)/1e6)
+	}
+}
+
+// TestOpenLoopDriftsUnderTheSameDelivery shows the test above is not passing
+// by luck.  The per-frame version walks away at about 1.2s per minute here,
+// which is what the real camera was measured doing (video 285.1s against
+// audio 291.3s after 4.8 minutes) — the model is calibrated against that.
+func TestOpenLoopDriftsUnderTheSameDelivery(t *testing.T) {
+	const span = 10 * time.Minute
+	r := &rng{s: 42}
+	video := buildStream(realVideoDeltas, 694144, span, false, r, 0)
+	audio := buildStream(realAudioDeltas, 52613, span, true, r, audioBurstEvery)
+	stream := merge(video, audio)
+
+	epoch := time.Unix(1700000000, 0)
+	var vt, at openLoopTracker
+	var lastVideo, lastAudio uint64
+	for _, f := range stream {
+		now := epoch.Add(f.when)
+		if f.audio {
+			lastAudio = at.update(f.raw, now)
+		} else {
+			lastVideo = vt.update(f.raw, now)
+		}
+	}
+
+	split := int64(lastAudio) - int64(lastVideo)
+	t.Logf("open loop ended %.1fs apart after %v", float64(split)/1e6, span)
+	if split < int64(3*time.Second/time.Microsecond) {
+		t.Fatalf("expected the open loop to run away by seconds, got %.3fs", float64(split)/1e6)
+	}
+}
+
+// TestClosedLoopStillRecoversARealGap: bounding the correction must not cost
+// us the thing it was added for.
+func TestClosedLoopStillRecoversARealGap(t *testing.T) {
+	epoch := time.Unix(1700000000, 0)
+	h := NewFrameHandler(false)
+
+	const startRaw = 500000
+	h.videoTS.update(startRaw, epoch)
+
+	// The camera really did stop for 3.2s, and says so in its own clock.
+	gap := 3200 * time.Millisecond
+	got := h.videoTS.update(rawAt(startRaw, gap), epoch.Add(gap))
+
+	if want := uint64(gap / time.Microsecond); got != want {
+		t.Fatalf("after a %v gap the timeline advanced %d us, want %d us", gap, got, want)
+	}
+}
+
+// TestClosedLoopNeverGoesBackwards: downstream consumers need a clock that
+// only moves forward, so an over-corrected timeline must stall, not rewind.
+func TestClosedLoopNeverGoesBackwards(t *testing.T) {
+	epoch := time.Unix(1700000000, 0)
+	h := NewFrameHandler(false)
+
+	const startRaw = 100000
+	prev := h.videoTS.update(startRaw, epoch)
+
+	// Frames whose camera clock races ahead of real time.
+	cameraUS := uint64(0)
+	for i := 1; i <= 200; i++ {
+		cameraUS += 50000
+		raw := uint32((uint64(startRaw) + cameraUS) % uint64(tsWrapPeriod))
+		// real time advances at a quarter of that rate
+		now := epoch.Add(time.Duration(cameraUS/4) * time.Microsecond)
+		got := h.videoTS.update(raw, now)
+		if got < prev {
+			t.Fatalf("timeline went backwards at frame %d: %d after %d", i, got, prev)
+		}
+		prev = got
+	}
+}
diff --git a/pkg/tutk/frame_ts_test.go b/pkg/tutk/frame_ts_test.go
new file mode 100644
index 0000000..ecfae64
--- /dev/null
+++ b/pkg/tutk/frame_ts_test.go
@@ -0,0 +1,251 @@
+package tutk
+
+import (
+	"testing"
+	"time"
+)
+
+// The camera sends only the microsecond part of its clock, wrapping every
+// second.  These helpers turn an absolute elapsed time into the raw field the
+// camera would have sent.
+func rawAt(startRaw uint32, elapsed time.Duration) uint32 {
+	return uint32((uint64(startRaw) + uint64(elapsed/time.Microsecond)) % uint64(tsWrapPeriod))
+}
+
+func newHandlerForTest() *FrameHandler {
+	return NewFrameHandler(false)
+}
+
+func TestSteadyStreamKeepsSubSecondPrecision(t *testing.T) {
+	h := newHandlerForTest()
+	wall := time.Unix(1700000000, 0)
+	const startRaw = 694144
+	// 20fps, and deliberately not a round 50ms: the camera's own spacing must
+	// survive, because that is what A/V sync depends on.
+	const frame = 49971 * time.Microsecond
+
+	// The first frame establishes the origin and reads zero.
+	if got := h.videoTS.update(startRaw, wall); got != 0 {
+		t.Fatalf("first frame should start the timeline at 0, got %d", got)
+	}
+
+	const frames = 100
+	var last uint64
+	for i := 1; i <= frames; i++ {
+		elapsed := time.Duration(i) * frame
+		wall = wall.Add(frame)
+		last = h.videoTS.update(rawAt(startRaw, elapsed), wall)
+	}
+
+	want := uint64(frames * frame / time.Microsecond)
+	if last != want {
+		t.Fatalf("accumulated %d us over %d frames, want %d us", last, frames, want)
+	}
+}
+
+func TestGapLongerThanOneSecondIsRecovered(t *testing.T) {
+	h := newHandlerForTest()
+	wall := time.Unix(1700000000, 0)
+	const startRaw = 500000
+
+	h.videoTS.update(startRaw, wall)
+
+	// A 3.2s stall: the raw counter wrapped three times, which the field
+	// cannot express.  Unpatched, this advanced the timeline by 200ms and lost
+	// three seconds for good.
+	gap := 3200 * time.Millisecond
+	wall = wall.Add(gap)
+	got := h.videoTS.update(rawAt(startRaw, gap), wall)
+
+	want := uint64(gap / time.Microsecond)
+	if got != want {
+		t.Fatalf("after a %v gap the timeline advanced %d us, want %d us", gap, got, want)
+	}
+}
+
+func TestGapRecoveryToleratesDeliveryJitter(t *testing.T) {
+	h := newHandlerForTest()
+	wall := time.Unix(1700000000, 0)
+	const startRaw = 100000
+
+	h.videoTS.update(startRaw, wall)
+
+	// The camera's clock says 2.5s elapsed; the frame arrives 180ms late.
+	// Rounding to the nearest second must still yield exactly 2.5s.
+	cameraGap := 2500 * time.Millisecond
+	wall = wall.Add(cameraGap + 180*time.Millisecond)
+	got := h.videoTS.update(rawAt(startRaw, cameraGap), wall)
+
+	want := uint64(cameraGap / time.Microsecond)
+	if got != want {
+		t.Fatalf("jittered arrival produced %d us, want %d us", got, want)
+	}
+}
+
+func TestTimelineNeverGoesBackwards(t *testing.T) {
+	h := newHandlerForTest()
+	wall := time.Unix(1700000000, 0)
+	const startRaw = 900000
+
+	prev := h.videoTS.update(startRaw, wall)
+	// Frames arriving out of order, or a wall clock that stepped backwards,
+	// must not rewind the timeline.
+	for _, step := range []time.Duration{-time.Second, 0, 40 * time.Millisecond} {
+		wall = wall.Add(step)
+		got := h.videoTS.update(rawAt(startRaw, 40*time.Millisecond), wall)
+		if got < prev {
+			t.Fatalf("timeline went backwards: %d us after %d us", got, prev)
+		}
+		prev = got
+	}
+}
+
+func TestTracksShareAnOrigin(t *testing.T) {
+	h := newHandlerForTest()
+	wall := time.Unix(1700000000, 0)
+
+	// Video starts first and runs for 10 seconds before any audio shows up —
+	// the situation that used to leave audio 10s behind video for the life of
+	// the connection.
+	h.videoTS.update(694144, wall)
+	audioStart := wall.Add(10 * time.Second)
+	video := h.videoTS.update(rawAt(694144, 10*time.Second), audioStart)
+	audio := h.audioTS.update(52613, audioStart)
+
+	diff := int64(video) - int64(audio)
+	if diff < -1000 || diff > 1000 {
+		t.Fatalf("tracks started %d us apart, want them aligned within 1ms", diff)
+	}
+}
+
+func TestTracksStayAlignedWhileBothRun(t *testing.T) {
+	h := newHandlerForTest()
+	wall := time.Unix(1700000000, 0)
+
+	const videoRaw, audioRaw = 694144, 52613
+	h.videoTS.update(videoRaw, wall)
+	h.audioTS.update(audioRaw, wall)
+
+	// 60s of video at 20fps and audio at 16kHz/1024, plus a 2.5s audio stall
+	// partway through — the exact shape that produced the real-world drift.
+	var video, audio uint64
+	const videoFrame = 49971 * time.Microsecond
+	const audioFrame = 64 * time.Millisecond
+
+	elapsed := time.Duration(0)
+	for i := 1; i <= 1200; i++ {
+		elapsed = time.Duration(i) * videoFrame
+		video = h.videoTS.update(rawAt(videoRaw, elapsed), wall.Add(elapsed))
+	}
+
+	audioElapsed := time.Duration(0)
+	for i := 1; audioElapsed < elapsed; i++ {
+		audioElapsed = time.Duration(i) * audioFrame
+		if audioElapsed > 20*time.Second && audioElapsed <= 22500*time.Millisecond {
+			continue // the stall: no audio frames delivered at all
+		}
+		audio = h.audioTS.update(rawAt(audioRaw, audioElapsed), wall.Add(audioElapsed))
+	}
+
+	diff := int64(video) - int64(audio)
+	if diff < 0 {
+		diff = -diff
+	}
+	// Both tracks should land within one frame of each other.
+	if diff > int64(100*time.Millisecond/time.Microsecond) {
+		t.Fatalf("tracks drifted %d us apart over 60s with a stall, want < 100ms", diff)
+	}
+}
+
+// legacyTracker is the reconstruction this patch replaces, kept here so the
+// tests above are demonstrably testing something: each scenario must fail
+// against it and pass against tsTracker.
+type legacyTracker struct {
+	lastRawTS uint32
+	accumUS   uint64
+	firstTS   bool
+}
+
+func (t *legacyTracker) update(rawTS uint32) uint64 {
+	if !t.firstTS {
+		t.firstTS = true
+		t.lastRawTS = rawTS
+		return 0
+	}
+	var delta uint32
+	if rawTS >= t.lastRawTS {
+		delta = rawTS - t.lastRawTS
+	} else {
+		delta = (tsWrapPeriod - t.lastRawTS) + rawTS
+	}
+	t.accumUS += uint64(delta)
+	t.lastRawTS = rawTS
+	return t.accumUS
+}
+
+func TestLegacyLosesWholeSecondsInAGap(t *testing.T) {
+	var legacy legacyTracker
+	const startRaw = 500000
+	legacy.update(startRaw)
+
+	gap := 3200 * time.Millisecond
+	got := legacy.update(rawAt(startRaw, gap))
+
+	// 3.2s elapsed, but the counter can only express the 200ms remainder.
+	if got != uint64(200*time.Millisecond/time.Microsecond) {
+		t.Fatalf("expected the old code to report 200ms for a %v gap, got %d us", gap, got)
+	}
+	if got == uint64(gap/time.Microsecond) {
+		t.Fatal("old code unexpectedly handled the gap; the fix would be untested")
+	}
+}
+
+func TestLegacyLosesAnExactMultipleOfTheWrapEntirely(t *testing.T) {
+	var legacy legacyTracker
+	const startRaw = 694144
+	legacy.update(startRaw)
+
+	// Ten seconds is an exact multiple of the one-second wrap, so the counter
+	// comes back to the same value and the old code advances by nothing at all.
+	got := legacy.update(rawAt(startRaw, 10*time.Second))
+	if got != 0 {
+		t.Fatalf("expected the old code to see a 10s gap as zero, got %d us", got)
+	}
+}
+
+func TestLegacyStartsTracksAtUnrelatedOrigins(t *testing.T) {
+	var video, audio legacyTracker
+
+	// Kept under a second so this isolates the origin defect from the
+	// lost-whole-seconds one.
+	const startRaw = 100000
+	const lead = 600 * time.Millisecond
+
+	video.update(startRaw)
+	videoNow := video.update(rawAt(startRaw, lead))
+	// Audio's first frame arrives alongside that video frame, yet the old code
+	// zeroes it on its own first frame and nothing ever closes the gap.
+	audioNow := audio.update(52613)
+
+	if audioNow != 0 {
+		t.Fatalf("expected the old code to zero audio on its own first frame, got %d", audioNow)
+	}
+	if videoNow-audioNow != uint64(lead/time.Microsecond) {
+		t.Fatalf("expected a %v split between tracks, got %d us", lead, videoNow-audioNow)
+	}
+}
+
+func TestPatchedTracksAlignInTheSameScenario(t *testing.T) {
+	h := newHandlerForTest()
+	wall := time.Unix(1700000000, 0)
+	const startRaw = 100000
+	const lead = 600 * time.Millisecond
+
+	h.videoTS.update(startRaw, wall)
+	video := h.videoTS.update(rawAt(startRaw, lead), wall.Add(lead))
+	audio := h.audioTS.update(52613, wall.Add(lead))
+
+	if diff := int64(video) - int64(audio); diff < -1000 || diff > 1000 {
+		t.Fatalf("tracks %d us apart, want aligned within 1ms", diff)
+	}
+}
