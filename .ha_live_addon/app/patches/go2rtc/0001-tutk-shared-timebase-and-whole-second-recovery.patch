 	if !t.firstTS {
 		t.firstTS = true
 		t.lastRawTS = rawTS
-		return 0
+		t.lastWall = now
+
+		if t.base == nil || !t.base.set {
+			if t.base != nil {
+				t.base.epoch = now
+				t.base.set = true
+			}
+			t.accumUS = 0
+		} else if since := now.Sub(t.base.epoch); since > 0 {
+			// Another track already defined the origin; join its timeline
+			// instead of starting a second one at zero.
+			t.accumUS = uint64(since / time.Microsecond)
+		}
+
+		return t.accumUS
 	}
 
 	var delta uint32
@@ -234,14 +280,27 @@ func (t *tsTracker) update(rawTS uint32) uint64 {
 		delta = (tsWrapPeriod - t.lastRawTS) + rawTS
 	}
 
-	t.accumUS += uint64(delta)
+	advance := uint64(delta)
+
+	// Recover the whole seconds the camera's counter cannot express.  Rounding
+	// to the nearest second absorbs up to half a second of delivery jitter.
+	if wall := now.Sub(t.lastWall); wall > 0 {
+		missing := (wall - time.Duration(delta)*time.Microsecond + time.Second/2) / time.Second
+		if missing > 0 {
+			advance += uint64(missing) * uint64(tsWrapPeriod)
+		}
+	}
+
+	t.accumUS += advance
 	t.lastRawTS = rawTS
+	t.lastWall = now
 
 	return t.accumUS
 }
 
