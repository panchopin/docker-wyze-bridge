 const tsWrapPeriod uint32 = 1000000
 
+// The camera stamps each frame with the microsecond part of its clock only:
+// the field counts 0..999999 and wraps every second, and the seconds themselves
+// are never transmitted.  Reconstructing elapsed time from those deltas alone
+// has two consequences that have to be corrected here.
+//
+// First, a gap longer than one second is invisible.  The wrap branch below can
+// only ever assume a single wrap, so if a track stalls for 1.4s the delta reads
+// 0.4s and the whole second is lost from that track's timeline, permanently.
+//
+// Second, video and audio are separate counters.  Zeroing each one on its own
+// first frame gives the two tracks unrelated origins, so they start out offset
+// by however long the second track took to show up.
+//
+// Both are resolved with the frame's arrival time, which is accurate to well
+// under a second on a local link.  Arrival time decides only how many *whole*
+// seconds to add and where a track's timeline begins; the camera's counter
+// still supplies the exact sub-second spacing, which is what actually matters
+// for A/V sync and frame pacing.
+//
+// Getting this wrong is not cosmetic: MediaMTX's fMP4 recorder discards audio
+// samples that fall before the current segment's start, so a slipped audio
+// timeline silently drops audio from recordings.
+
+// tsBase is the origin shared by every track of one connection.
+type tsBase struct {
+	epoch time.Time
+	set   bool
+}
+
 type tsTracker struct {
+	base      *tsBase
 	lastRawTS uint32
+	lastWall  time.Time
 	accumUS   uint64
 	firstTS   bool
 }
 
